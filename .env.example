# Copy this file to `.env` and set values (one KEY=value per line).
# Put secrets only in `.env` — do not commit it.

# Feed messages stay in memory only; profiles in data/app.db. Default UI language is English.

# Server (local). On Render, PORT is set automatically — leave unset there.
PORT=80
HOST=0.0.0.0
# COOKIE_SECRET=   # use a long random string in production / Render

# Feed: max messages returned and shown (1–500)
# FEED_DISPLAY_LIMIT=50

# Batch translate: max parallel Gemini calls per batch request (1–16)
# TRANSLATE_CONCURRENCY=4

# Max message IDs per POST /api/translate/batch (1–200)
# TRANSLATE_BATCH_MAX=50

# Gemini (feed). Set on the server only (.env locally, or Render Environment)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Do not use *-flash-lite models (retired for new API users).

# Used in Gemini prompts for translation tone / context (optional)
TRANS_TONE=neutral
TRANS_DOMAIN=

# --- Render (single Web Service) ---
# 1. Push this repo to GitHub/GitLab
# 2. Render → New → Blueprint (uses render.yaml) OR New → Web Service:
#      Build: npm install
#      Start: npm start
#      Node: set env NODE_VERSION=22.13.0 (or >=22.13; npm start passes --experimental-sqlite)
# 3. Add GEMINI_API_KEY in Render → Environment
# 4. Open https://<service>.onrender.com  (UI + API on the same URL)
# Free tier sleeps after ~15 min idle; first hit may take ~1 min.
